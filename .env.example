# Copy this file to .env and fill in the keys you have. Every integration is
# optional — DataFetcher skips any connector whose keys are missing and falls
# back to the generic scraper (or a heuristic query parser if no Anthropic key
# is set). See README.md for where to get free-tier keys.

# --- LLM query parsing ---
# Tried in order: Anthropic, then Gemini, then a heuristic fallback parser.
# Both are optional and independent of each other — set whichever you have.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free tier via https://aistudio.google.com/apikey (no credit card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Image connectors ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Text/article connectors ---
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DataFetcher/0.1 by yourusername

# --- Web search for the scraper fallback (optional) ---
# Without these, the scraper can still crawl domains you explicitly list in
# a query's domain_allowlist, but has no way to discover URLs across the
# whole web (by design — we don't scrape search engines' result pages, since
# that means fighting their bot detection).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Scraper fallback behavior ---
SCRAPER_USER_AGENT=DataFetcherBot/0.1 (+https://github.com/Somesh2223/DataFetcher; contact: you@example.com)
SCRAPER_MAX_PAGES_PER_DOMAIN=5
SCRAPER_MIN_DELAY_SECONDS=1.0
SCRAPER_MAX_RETRIES=3
SCRAPER_RENDER_JS=false

# --- Dedup thresholds ---
IMAGE_PHASH_HAMMING_THRESHOLD=6
TEXT_JACCARD_THRESHOLD=0.8

# --- Storage / server ---
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
